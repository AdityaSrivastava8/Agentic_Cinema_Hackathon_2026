# Main run command for Streamlit on port 8080
run = "streamlit run app.py --server.port 8080 --server.address 0.0.0.0"

# Language configuration
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

# Deployment target configuration for Replit hosting
[deployment]
run = ["sh", "-c", "streamlit run app.py --server.port 8080 --server.address 0.0.0.0"]
deploymentTarget = "cloudrun"

# Open port 8080 for web dashboard preview
[[ports]]
localPort = 8080
externalPort = 8080
