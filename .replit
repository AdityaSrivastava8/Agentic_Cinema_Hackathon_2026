# Replit deployment command.
run = "streamlit run Sentinel-A2A/frontend/app.py --server.port 5000 --server.address 0.0.0.0"

# Language configuration
entrypoint = "Sentinel-A2A/frontend/app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

# Deployment target configuration for Replit hosting
[deployment]
run = ["sh", "-c", "streamlit run Sentinel-A2A/frontend/app.py --server.port 5000 --server.address 0.0.0.0"]
deploymentTarget = "cloudrun"

# Open port 5000 for the Replit deployment
[[ports]]
localPort = 5000
externalPort = 5000
