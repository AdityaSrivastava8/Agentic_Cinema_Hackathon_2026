# Replit deployment command.
run = "python -m streamlit run app.py --server.address 0.0.0.0 --server.port 5000 --server.headless true --browser.gatherUsageStats false"

# Language configuration
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m streamlit run app.py --server.address=0.0.0.0 --server.port=5000 --server.headless=true --browser.gatherUsageStats=false"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# Deployment target configuration for Replit hosting
[deployment]
run = ["python", "-m", "streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "5000", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
deploymentTarget = "autoscale"

# Open port 5000 for the Replit deployment
[[ports]]
localPort = 5000
externalPort = 80
