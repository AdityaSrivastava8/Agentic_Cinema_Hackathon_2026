# Replit deployment command. CLI flags avoid first-run prompts in production.
run = "python -m streamlit run app.py --server.port 5000 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"

# Language configuration
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

# Deployment target configuration for Replit hosting
[deployment]
run = ["sh", "-c", "python -m streamlit run app.py --server.port 5000 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
deploymentTarget = "cloudrun"

# Open port 5000 for the Replit deployment
[[ports]]
localPort = 5000
externalPort = 5000
