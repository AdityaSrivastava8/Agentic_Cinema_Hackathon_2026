# Replit deployment command.
run = "python -m streamlit run Sentinel-A2A/frontend/app.py --server.address 0.0.0.0 --server.port 5000 --server.headless true --browser.gatherUsageStats false"

# Language configuration
entrypoint = "Sentinel-A2A/frontend/app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pip install -r Sentinel-A2A/requirements.txt --disable-pip-version-check --quiet && exec python -m streamlit run Sentinel-A2A/frontend/app.py --server.address=0.0.0.0 --server.port=5000 --server.headless=true --browser.gatherUsageStats=false"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
run = ["sh", "-c", "python -m pip install -r Sentinel-A2A/requirements.txt --disable-pip-version-check --quiet && exec python -m streamlit run Sentinel-A2A/frontend/app.py --server.address 0.0.0.0 --server.port 5000 --server.headless true --browser.gatherUsageStats false"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80 
